# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build info
*.tsbuildinfo

# Plate renderer intermediates. `render.mjs` writes PNG masters here and
# `encode.mjs` turns them into the WebP/WebM under public/media, which IS
# committed. The masters are reproducible from the shaders — 533MB of them —
# so they are output, not source. `node tools/plates/encode.mjs --clean` removes them.
tools/plates/out/

# `/brag` skill output: a rendered launch video and its capture set. Generated
# from the site itself, and regenerable; the brief in docs/ is the source.
brag-output/

# Env — never commit credentials
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent skill packs, fetched from GitHub by `npx skills add`.
# Regenerable from skills-lock.json, which IS committed — so this is the
# node_modules pattern: lock the versions, don't vendor 472KB of third-party
# content we didn't write and haven't reviewed.
# .claude/skills holds only symlinks into .agents, which don't travel well in git.
.agents/
.claude/skills/
