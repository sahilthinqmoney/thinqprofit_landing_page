# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build info
*.tsbuildinfo

# `/brag` skill output: a rendered launch video and its capture set. Generated
# from the site itself, and regenerable; the brief in docs/ is the source.
brag-output/

# Screenshots written by the browser tooling while checking the rendered page.
# One PNG per capture, regenerated on every run — output, not source.
.browser-sessions/

# Env — never commit credentials
.env
.env.*
!.env.example
# Local-only values for `wrangler dev`; the real ones live as Worker secrets.
.dev.vars
.dev.vars.*

# wrangler's local state: the miniflare sandbox and build cache, rebuilt on demand.
.wrangler/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent skill packs, fetched from GitHub by `npx skills add`.
# Regenerable from skills-lock.json, which IS committed — so this is the
# node_modules pattern: lock the versions, don't vendor 472KB of third-party
# content we didn't write and haven't reviewed.
# .claude/skills holds only symlinks into .agents, which don't travel well in git.
.agents/
.claude/skills/

# Obsidian's per-vault state. The repo root is a vault so the codebase can be
# browsed and edited in Obsidian; the notes and code are source and stay in git,
# but workspace layout, window state and the downloaded community plugins are
# per-machine. `app.json` (ignore filters, link style) and `core-plugins.json`
# define how the vault behaves for everyone, so they are the exceptions —
# same reasoning as .agents/: lock the config, don't vendor the plugin code.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
docs/.obsidian/
