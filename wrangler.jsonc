{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thinqprofit-landing-page",
  // Pinned to what the installed wrangler's bundled runtime supports, so
  // `wrangler dev` serves the same thing locally that gets deployed.
  "compatibility_date": "2026-08-08",
  // A script now sits in front of the assets, because /api/ has to reach
  // authService and everything else must still be the static bundle. See
  // worker/index.ts for why the API cannot simply be called from the browser.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Bound so the script can serve the bundle itself. Without a binding the
    // assets would be served ahead of the script and /api/ would never reach it.
    "binding": "ASSETS",
    // Every unmatched path renders index.html so client-side routing works,
    // which is what vercel.json's rewrite did.
    "not_found_handling": "single-page-application"
  },
  "vars": {
    /*
     * Where authService listens: a Cloudflare Tunnel on this zone.
     *
     * A HOSTNAME, and not by preference — a Worker cannot fetch a raw address.
     * Pointing this at http://13.201.234.55:8080 deployed cleanly and then
     * answered every /api/ request with Cloudflare error 1003, "Direct IP
     * access not allowed"; the fetch never left the edge.
     *
     * The stopgap between then and now was 13.201.234.55.nip.io, which resolved
     * the embedded address back to the same box under a name Cloudflare would
     * accept. It cost two things this does not: the hop ran over plain HTTP,
     * so OTP codes and session cookies crossed the internet in the clear, and
     * resolution depended on a third party nobody here operates.
     *
     * The tunnel closes both. `cloudflared` runs on the origin and dials out,
     * so traffic arrives down that connection rather than through an exposed
     * port — which is why the address itself appears nowhere any more, and why
     * 8080 can be closed to the public entirely.
     */
    "AUTH_ORIGIN": "https://auth.thinq.co"
  },
  "observability": {
    // Worth having now that a script handles authentication traffic: without
    // logs, a failure in the proxy is invisible and indistinguishable from a
    // failure in the service behind it.
    "enabled": true
  }
}
